{
  "openapi": "3.1.0",
  "info": {
    "title": "H&E Slide Harmonizer Agent — Numeric Audit API",
    "description": "Demonstration numeric-rule task audit. No image harmonization or validated clinical decision support.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counts for processed tasks and audit blocks",
        "responses": {
          "200": {
            "description": "JSON operational summary"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate numeric inputs using illustrative thresholds",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demonstration dossier and signed audit chain entry"
          },
          "400": {
            "description": "Prohibited identifier detected"
          },
          "422": {
            "description": "Invalid task schema or nonfinite numeric metric"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic local mock query (not an external language model)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    }
  }
}
